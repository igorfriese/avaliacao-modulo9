<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sistema de Tarefas</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/avaliacao_modulo9.styles.css" asp-append-version="true" />
</head>
    <body>
        <header>
            <nav class = "navbar navbar-expand-lg navbar-dark bg-dark shadow">
                <div class = "container">
                    <a class = "navbar-brand" asp-controller = "Home" asp-action = "Index">Sistema de Tarefas</a>

                    <!-- Botão para Celular -->
                    <button class = "navbar-toggler" type = "button" data-bs-toggle = "collapse" data-bs-target = "#navbarMenu" aria-controls = "navbarMenu" aria-expanded = "false" aria-label = "Alterar navegação">
                        <span class = "navbar-toggler-icon"></span>
                    </button>

                    <!-- Menu -->
                    <div class = "collapse navbar-collapse" id = "navbarMenu">
                        <ul class = "navbar-nav me-auto">
                            <li class = "nav-item">
                                <a class = "nav-link" asp-controller = "Tarefas" asp-action = "Index">Tarefas</a>
                            </li>

                            <li class = "nav-item" asp-controller = "Tarefas" asp-action = "Index">Tarefas</li>
                        </ul>

                        <div class = "d-flex">
                            @if (User.Identity != null && User.Identity.IsAuthenticated)
                            {
                                <span class = "navbar-text text-white me-3">@User.Identity.Name</span>
                                <a asp-controller = "Conta" asp-action = "Logout" class = "btn btn-outline-light">Logout</a>
                            }
                            else
                            {
                                <a asp-controller = "Conta" asp-action = "Login" class = "btn btn-primary">Login</a>
                            }
                        </div>
                    </div>
            </div>
        </nav>
    </header>

    <main class = "container mt-4">@RenderBody()</main>

    <footer class = "border-top mt-5 py-3">
        <div class="container text-center text-muted">&copy; 2026 - Sistema de Tarefas</div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
