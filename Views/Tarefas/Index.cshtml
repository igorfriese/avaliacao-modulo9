@model IEnumerable<avaliacao_modulo9.Models.Tarefa>

@{
    ViewData["Title"] = "Lista de Tarefas";
    var statusSelecionado = Context.Request.Query["status"].ToString();
}

<div class = "d-flex justify-content-between align-items-center mb-4">
    <h2 class = "mb-0">Lista de Tarefas</h2>

    <a asp-action = "Create" class = "btn btn-success">Nova Tarefa</a>
</div>

<form method = "get" class = "row g-3 mb-4">
    <div class = "col-md-4">
        <label for = "status" class = "form-label">Filtrar por Status</label>
        
        <select id = "status" name = "status" class = "form-select">
            
            @if (string.IsNullOrEmpty(statusSelecionado))
                {
                    <option value = "" selected>Todas</option>    
                }
                else
                {
                    <option value = "">Todas</option>
                }

            @if (statusSelecionado == "true")
                {
                    <option value = "true" selected>Concluídas</option>    
                }
                else
                {
                    <option value = "true">Concluídas</option>
                }

            @if (statusSelecionado == "false")
                {
                    <option value = "false" selected>Pendentes</option>
                }
                else
                {
                    <option value = "false">Pendentes</option>
                }

        </select>
    </div>

    <div class="col-md-2 d-flex align-items-end">
        <button type = "submit" class = "btn btn-primary w-100">Filtrar</button>
    </div>
</form>

<div class = "table-responsive">
<table class = "table table-hover table-bordered align-middle">
    <thead class = "table-dark">

        <tr>

            <th>Título</th>
            <th>Descrição</th>
            <th>Data</th>
            <th>Status</th>
            <th class = "text-center">Ações</th>

        </tr>
    </thead>

    <tbody>
        @if (Model.Any())
        {
                @foreach (var item in Model)
                {
                
                <tr>

                    <td>@item.Titulo</td>
                    <td>@item.Descricao</td>
                    <td>@item.Data.ToString("dd/MM/yyyy")</td>

                    <td>
                        @if (item.StatusConcluida)
                        {
                            <span class = "badge bg-success">Concluída</span>
                        }
                        else
                        {
                            <span class = "badge bg-warning text-dark">Pendente</span>
                        }
                    </td>

                    <td class = "text-center">
                        <a asp-action = "Details" asp-route-id = "@item.Id" class="btn btn-info btn-sm">Detalhes</a>
                        <a asp-action = "Edit" asp-route-id = "@item.Id" class="btn btn-warning btn-sm">Editar</a>
                        <a asp-action = "Delete" asp-route-id = "@item.Id" class = "btn btn-danger btn-sm">Excluir</a>
                    </td>
                </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan = "5" class = "text-center text-muted py-4">Nenhuma tarefa encontrada.</td>
                </tr>
            }
        </tbody>
    </table>
</div>